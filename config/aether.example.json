{
  "schema_version": 3,
  "engine": {
    "enabled": true,
    "mode": "observe_only",
    "policy_authority": "aether_core_decisions_without_execution"
  },
  "supervisor": {
    "sampling_interval_ms": 1000,
    "max_process_observations": 128
  },
  "core_policy": {
    "moderate_available_ratio": 0.15,
    "high_available_ratio": 0.10,
    "critical_available_ratio": 0.05,
    "moderate_psi_some_avg10": 1.0,
    "high_psi_some_avg10": 5.0,
    "critical_psi_some_avg10": 10.0,
    "moderate_psi_full_avg10": 0.10,
    "high_psi_full_avg10": 1.0,
    "critical_psi_full_avg10": 5.0,
    "recovery_available_margin": 0.02,
    "recovery_psi_margin": 0.50,
    "recovery_samples": 2,
    "max_observation_age_ms": 5000,
    "target_available_ratio": 0.15,
    "max_reclaim_per_cycle_kib": 65536
  },
  "platform_adapters": {
    "procfs": "read_only",
    "psi": "feature_detect",
    "cgroup_v2": "inspect_only",
    "memory_reclaim": "disabled",
    "zram": "telemetry_only",
    "damon": "disabled"
  },
  "diagnostics": {
    "log_level": "info",
    "event_history_limit": 256
  }
}
